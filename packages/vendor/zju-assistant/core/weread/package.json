{
  "name": "weread-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从微信读书查找公众号文章，读取正文并导出 Markdown",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "weread": "scripts/weread.ts"
  },
  "scripts": {
    "weread": "node scripts/weread.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "entities": "^8.1.0",
    "htmlparser2": "^10.1.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "optionalDependencies": {
    "electron": "44.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0"
  }
}
