{
    "name": "@lybx-leyw/dsh-pages",
    "version": "0.1.3",
    "description": "Product pages on top of DeepSeek Harness: a page slot tree that hosts the native workbench as one page",
    "private": false,
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./client": {
            "import": "./lib/client.mjs",
            "default": "./lib/client.js"
        },
        "./state": "./src/state.js",
        "./package.json": "./package.json"
    },
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek",
        "harness",
        "pages",
        "layout",
        "slots"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lybx-leyw/dsh-pages.git"
    },
    "homepage": "https://github.com/lybx-leyw/dsh-pages#readme",
    "bugs": {
        "url": "https://github.com/lybx-leyw/dsh-pages/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": "^22.19.0 || >=24.0.0"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": ">=4.0.2 <5"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/cordis": {
            "optional": true
        }
    },
    "scripts": {
        "build": "node build.mjs",
        "test": "node --test tests/*.test.mjs",
        "prepublishOnly": "npm test && npm run build"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.5",
        "esbuild": "0.25.12",
        "playwright": "1.56.1",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "files": [
        "src",
        "lib",
        "docs",
        "cordis.patch.yml",
        "README.md",
        "README-ZH.md",
        "LICENSE",
        "VERSIONING.md",
        "DESIGN.md",
        "DESIGN-ZH.md"
    ]
}
