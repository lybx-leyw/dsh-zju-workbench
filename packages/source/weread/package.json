{
  "name": "@lybx-leyw/dsh-zju-source-weread",
  "version": "0.1.0",
  "private": true,
  "description": "从微信读书查找公众号文章，读取正文并导出 Markdown",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "weread": "scripts/weread.ts"
  },
  "scripts": {
    "weread": "node scripts/weread.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "ATTRIBUTION.md",
    "LICENSE-Tencent",
    "THIRD_PARTY_NOTICES.txt",
    "lib/",
    "scripts/",
    "references/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/source/weread"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "capability": {
      "tier": 1,
      "auth": "none",
      "network": "public",
      "writes": false,
      "requires": []
    }
  },
  "dependencies": {
    "commander": "^14.0.0",
    "entities": "^8.1.0",
    "htmlparser2": "^10.1.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "optionalDependencies": {
    "electron": "44.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0"
  }
}
