{
  "name": "@lybx-leyw/dsh-zju-source-campus",
  "version": "0.1.0",
  "description": "浙大校园数据源：学在浙大待办与拼题A 题集（本仓原生实现，复用已验证的 CAS 与 HTTP 传输）",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./http": "./src/cas/http.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/source/campus"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
    },
    "capability": {
      "tier": 1,
      "auth": "cas",
      "network": "campus",
      "writes": false,
      "requires": [
        "@lybx-leyw/dsh-zju-source-http",
        "@lybx-leyw/dsh-zju-source-login",
        "@lybx-leyw/dsh-zju-source-webvpn"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-source-login": "0.1.0",
    "@lybx-leyw/dsh-zju-source-webvpn": "0.2.0",
    "tough-cookie": "6.0.2",
    "undici": "^8.10.2",
    "@lybx-leyw/dsh-zju-source-http": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  }
}
