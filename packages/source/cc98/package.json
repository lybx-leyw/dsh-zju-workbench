{
  "name": "@lybx-leyw/dsh-zju-source-cc98",
  "version": "0.1.0",
  "description": "浙大 CC98 论坛（api.cc98.org）数据源：OAuth2 密码模式取令牌，10 个只读方法（搜索/帖子/十大/新帖/版面/用户/通知/私信），不含任何写操作",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ubb": "./src/ubb.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capability": {
      "tier": 1,
      "auth": "own",
      "network": "public",
      "writes": false,
      "requires": [
        "@lybx-leyw/dsh-zju-source-http",
        "@lybx-leyw/dsh-zju-source-login"
      ]
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-source-login": "0.1.0",
    "@lybx-leyw/dsh-zju-source-http": "0.1.0"
  },
  "license": "GPL-3.0-or-later"
}
