{
  "name": "@lybx-leyw/dsh-zju-source-xuezai",
  "version": "0.1.0",
  "description": "学在浙大（courses.zju.edu.cn）数据源：待办、课程活动、作业、课件与我的提交。只读，不含任何写操作",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/source/xuezai"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capability": {
      "tier": 1,
      "auth": "cas",
      "network": "public",
      "writes": false,
      "requires": [
        "@lybx-leyw/dsh-zju-source-http",
        "@lybx-leyw/dsh-zju-source-login"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-source-http": "0.1.0",
    "@lybx-leyw/dsh-zju-source-login": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  }
}
