    "README.md",
    "src/",
    "scripts/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "probe:hosts": "node scripts/probe-hosts.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/source/webvpn"
