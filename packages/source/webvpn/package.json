{
  "name": "@lybx-leyw/dsh-zju-source-webvpn",
  "version": "0.2.0",
  "description": "浙大 WebVPN 通路与出口策略：地址改写、网关登录、校园网探测与选路，供所有 zju 专属数据源共用（零第三方依赖）",
  "type": "module",
