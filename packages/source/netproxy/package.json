{
  "name": "@lybx-leyw/dsh-zju-source-netproxy",
  "version": "0.1.0",
  "description": "智云 Pro 的分域网络代理：所有出口流量经本地中继，按用户配置的域名规则分发到不同代理或直连，配可视化设置页",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/source/netproxy"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
    },
    "capability": {
      "tier": 0,
      "auth": "none",
      "network": "public",
      "writes": false,
      "requires": []
    }
  }
}
