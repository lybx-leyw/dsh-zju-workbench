{
  "name": "@lybx-leyw/dsh-zju-source-classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智云课堂独立数据源与 Cordis 服务",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./source": "./src/source.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "capability": {
      "tier": 1,
      "auth": "cas",
      "network": "campus",
      "writes": false,
      "requires": [
        "@lybx-leyw/dsh-zju-source-login"
      ]
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
    }
  },
  "dependencies": {
    "tough-cookie": "6.0.2",
    "@lybx-leyw/dsh-zju-source-login": "0.1.0",
    "undici": "^8.10.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  }
}
