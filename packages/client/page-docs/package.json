{
  "name": "@lybx-leyw/dsh-zju-page-docs",
  "version": "0.1.0",
  "description": "智云 Pro「文档」页：内置 markdown 的开发与协作文档，左侧目录 + 右侧页内目录 + 上下篇翻页",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./manifest": "./src/docs-manifest.js",
    "./outline": "./src/outline.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/client/page-docs"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
