{
  "name": "@lybx-leyw/dsh-zju-page-notes",
  "version": "0.1.0",
  "description": "「笔记」页（只含 UI）：Obsidian 式笔记库的界面 —— 双链、反链、标签、图谱。存储由 core-vault 提供",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/client/page-notes"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared",
        "@lybx-leyw/dsh-zju-ui-graph-render"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-core-vault": "0.1.0"
  }
}
