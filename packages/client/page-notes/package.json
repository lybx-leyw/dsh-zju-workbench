{
  "name": "@lybx-leyw/dsh-zju-page-notes",
  "version": "0.1.0",
  "description": "「笔记」页：Obsidian 式笔记库，双链、反链、标签，正文存成普通的 .md 文件",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared",
        "@lybx-leyw/dsh-zju-ui-graph-render"
      ]
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  },
  "license": "GPL-3.0-or-later"
}
