{
  "name": "@lybx-leyw/dsh-zju-page-planning",
  "version": "0.1.0",
  "description": "智云 Pro「规划」页（只含 UI）：列表、日历、日程与 pet 对话。数据聚合与路由由 core-planning 提供",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "src/",
    "cordis.patch.yml",
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lybx-leyw/dsh-zju-workbench.git",
    "directory": "packages/client/page-planning"
  },
  "license": "GPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@lybx-leyw/dsh-zju-ui-shared"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-core-planning": "0.1.0"
  }
}
