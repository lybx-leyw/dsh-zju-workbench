        "@lybx-leyw/dsh-zju-core-quiz",
        "@lybx-leyw/dsh-zju-page-quiz",
        "@lybx-leyw/dsh-zju-core-classroom-renderer"
      ]
    }
  },
  "dependencies": {
    "@lybx-leyw/dsh-zju-core-classroom-renderer": "0.1.0",
    "@lybx-leyw/dsh-zju-core-playback": "0.1.0",
    "@lybx-leyw/dsh-zju-core-quiz": "0.1.0",
    "@lybx-leyw/dsh-zju-page-quiz": "0.1.0",
    "hls.js": "1.7.3"
  }
