{
  "name": "@lybx-leyw/dsh-zju-page-study",
  "version": "0.1.0",
  "description": "智云 Pro「学习」页：课程树、讲义阅读、分层检索与习题（页面插件）",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
