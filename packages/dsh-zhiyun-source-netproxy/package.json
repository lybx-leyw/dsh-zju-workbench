{
  "name": "dsh-zhiyun-source-netproxy",
  "version": "0.1.0",
  "description": "智云 Pro 的分域网络代理：所有出口流量经本地中继，按用户配置的域名规则分发到不同代理或直连，配可视化设置页",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "external": ["dsh-zhiyun-shell-ui"] }
  }
}
