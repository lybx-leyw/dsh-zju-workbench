{
  "name": "dsh-zhiyun-shell-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "智云外层导航与 ask 内原生 DSH 工作区的布局桥接",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-workspace"] } },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.2 <5" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } }
}
