{
  "name": "dsh-zju-shell-workbench",
  "version": "0.1.0",
  "description": "ZJU Workbench 学习工作台：界面外壳（侧栏、页框架、主题、导航服务与插槽契约）",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-zju-shell-bridge",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": ["@lybx-leyw/dsh-zju-ui-shared"]
    }
  },
  "peerDependencies": { "@deepseek-ai/cordis": ">=4.0.2 <5" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } }
}
