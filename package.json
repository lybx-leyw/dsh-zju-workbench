{
  "name": "zhiyun-pro-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/radar/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "vendor:fetch": "node scripts/fetch-vendor.mjs",
    "vendor:check": "node scripts/fetch-vendor.mjs --check",
    "bench:quiz": "node scripts/quiz_bench/bench.mjs",
    "test:quiz-bench": "node --test tests/quiz-bench.test.mjs tests/quiz-accounting-guidance.test.mjs",
    "test:deeptutor": "node --test tests/deeptutor-host.test.mjs tests/deeptutor-bridge.test.mjs tests/deeptutor-service.test.mjs tests/deeptutor-integration.test.mjs tests/learning-resource.test.mjs tests/quiz-upstream.test.mjs",
    "test:deeptutor:selftest": "node scripts/deeptutor_bridge_selftest.mjs",
    "profile:init": "node scripts/profile.mjs init",
    "profile:check": "node scripts/profile.mjs check",
    "profile:dump": "node scripts/profile.mjs dump",
    "start": "node scripts/profile.mjs start",
    "desktop": "npm --prefix apps/desktop start",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "check:css": "node scripts/check-css-order.mjs",
    "test:classroom": "node --test tests/classroom*.test.mjs",
    "test:parser": "node --test tests/parser.test.mjs tests/parser-collage.test.mjs tests/parser-correction.test.mjs tests/parser-tree.test.mjs tests/parser-mix-merge-contract.test.mjs tests/parser-semantic-plan.test.mjs",
    "test:lecture": "node --test tests/lecture.test.mjs tests/lecture-polish.test.mjs tests/lecture-agent-text.test.mjs tests/lecture-reorganization.test.mjs tests/lecture-polish-patch.test.mjs tests/lecture-polish-cache.test.mjs tests/lecture-reconstructed-tree.test.mjs tests/lecture-polish-scoped.test.mjs",
    "test:study": "node --test tests/study.test.mjs",
    "test:study-host": "node scripts/test-study-host.mjs",
    "test:generation-host": "node scripts/test-generation-host.mjs",
    "parser:verify": "node scripts/parser-verify.mjs",
    "parser:parity": "node scripts/parser-reference.mjs",
    "classroom:verify": "node scripts/classroom-verify.mjs",
    "classroom:parity": "node scripts/classroom-parity.mjs",
    "classroom:live-probe": "node scripts/classroom-live-probe.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "classroom:golden-parity": "node scripts/classroom-golden-parity.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2",
    "esbuild": "0.25.12",
    "js-yaml": "4.1.0",
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
