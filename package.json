{
  "name": "zhiyun-pro-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/core/*",
    "packages/client/*",
    "packages/source/*",
    "packages/tool/*",
    "packages/preset/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "vendor:fetch": "node scripts/fetch-vendor.mjs",
    "vendor:check": "node scripts/fetch-vendor.mjs --check",
    "bench:quiz": "node scripts/quiz_bench/bench.mjs",
    "test:quiz-bench": "node --test tests/scripts/quiz-bench.test.mjs tests/core/quiz/quiz-accounting-guidance.test.mjs",
    "profile:init": "node scripts/profile.mjs init",
    "profile:check": "node scripts/profile.mjs check",
    "profile:dump": "node scripts/profile.mjs dump",
    "start": "node scripts/profile.mjs start",
    "desktop": "npm --prefix apps/desktop start",
    "dev": "npm run build && npm start",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:python": "python3 -m unittest discover -s tests/python -p \"test_*.py\"",
    "check:css": "node scripts/check-css-order.mjs",
    "test:classroom": "node --test \"tests/core/classroom-*/**/*.test.mjs\" \"tests/source/classroom/**/*.test.mjs\"",
    "test:parser": "node --test \"tests/core/parser/**/*.test.mjs\"",
    "test:lecture": "node --test \"tests/core/lecture/**/*.test.mjs\"",
    "test:study": "node --test \"tests/core/study/**/*.test.mjs\"",
    "test:study-host": "node scripts/test-study-host.mjs",
    "test:generation-host": "node scripts/test-generation-host.mjs",
    "parser:verify": "node scripts/parser-verify.mjs",
    "parser:parity": "node scripts/parser-reference.mjs",
    "classroom:verify": "node scripts/classroom-verify.mjs",
    "classroom:parity": "node scripts/classroom-parity.mjs",
    "classroom:live-probe": "node scripts/classroom-live-probe.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "classroom:golden-parity": "node scripts/classroom-golden-parity.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "esbuild": "0.25.12",
    "js-yaml": "4.1.0",
    "playwright": "1.56.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@lybx-leyw/dsh-pages": "0.1.3",
    "pptxgenjs": "^4.0.1"
  }
}
